PART 4 — Kernel-space eBPF program

Create:

nano bpf/tcp_monitor.bpf.c

Paste:

#include "vmlinux.h"

#include "../include/tcp_monitor.h"

#include <bpf/bpf_helpers.h>
#include <bpf/bpf_tracing.h>


/*
 * GPL license declaration.
 *
 * Some eBPF helpers require a GPL-compatible license.
 */
char LICENSE[] SEC("license") = "GPL";


/*
 * Ring Buffer
 *
 * Used to send events from kernel space
 * to user space.
 */
struct {
    __uint(type, BPF_MAP_TYPE_RINGBUF);
    __uint(max_entries, 256 * 1024);
} events SEC(".maps");


/*
 * Function 1:
 *
 * Monitor connect() system calls.
 *
 * Hook:
 * tracepoint/syscalls/sys_enter_connect
 */
SEC("tracepoint/syscalls/sys_enter_connect")
int monitor_connect(void *ctx)
{
    /*
     * Pointer to an event.
     *
     * This will point to memory reserved
     * inside the Ring Buffer.
     */
    struct event *e;


    /*
     * Ask the Ring Buffer for enough memory
     * to store one complete event.
     */
    e = bpf_ringbuf_reserve(
        &events,
        sizeof(*e),
        0
    );


    /*
     * If no memory is available,
     * safely stop this event.
     */
    if (!e)
        return 0;


    /*
     * Set event type.
     */
    e->type = EVENT_CONNECT;


    /*
     * Get current PID.
     *
     * bpf_get_current_pid_tgid() returns
     * PID/TGID information.
     *
     * >> 32 extracts the upper 32 bits.
     */
    e->pid = bpf_get_current_pid_tgid() >> 32;


    /*
     * Get current timestamp.
     *
     * Returned in nanoseconds.
     */
    e->timestamp_ns = bpf_ktime_get_ns();


    /*
     * Get current process name.
     *
     * Store it in:
     *
     * e->comm
     */
    bpf_get_current_comm(
        e->comm,
        sizeof(e->comm)
    );


    /*
     * Publish the event.
     *
     * After this, user space can receive it.
     */
    bpf_ringbuf_submit(e, 0);


    return 0;
}


/*
 * Function 2:
 *
 * Monitor TCP retransmission events.
 *
 * The Linux tcp_retransmit_skb tracepoint
 * is used when available on the system.
 */
SEC("tracepoint/tcp/tcp_retransmit_skb")
int monitor_retransmit(void *ctx)
{
    struct event *e;


    /*
     * Reserve Ring Buffer memory.
     */
    e = bpf_ringbuf_reserve(
        &events,
        sizeof(*e),
        0
    );


    /*
     * Ring Buffer full?
     *
     * Exit safely.
     */
    if (!e)
        return 0;


    /*
     * Mark event as retransmission.
     */
    e->type = EVENT_RETRANSMIT;


    /*
     * Get PID of currently running context.
     */
    e->pid = bpf_get_current_pid_tgid() >> 32;


    /*
     * Get timestamp.
     */
    e->timestamp_ns = bpf_ktime_get_ns();


    /*
     * Get process name.
     */
    bpf_get_current_comm(
        e->comm,
        sizeof(e->comm)
    );


    /*
     * Send event to user space.
     */
    bpf_ringbuf_submit(e, 0);


    return 0;
}
