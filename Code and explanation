PART 7 — User-space program

Create:

nano user/tcp_monitor.c

Paste:

#include <stdio.h>
#include <stdlib.h>
#include <signal.h>
#include <unistd.h>

#include <bpf/libbpf.h>

#include "../include/tcp_monitor.h"
#include "../tcp_monitor.skel.h"


/*
 * This variable controls the monitoring loop.
 *
 * 0 = Continue running
 * 1 = Stop program
 */
static volatile sig_atomic_t stop = 0;


/*
 * Signal handler.
 *
 * Called when the user presses Ctrl+C.
 */
static void handle_signal(int sig)
{
    stop = 1;
}


/*
 * Convert event type into readable text.
 */
static const char *event_type_to_string(unsigned int type)
{
    switch (type) {

        case EVENT_CONNECT:
            return "CONNECT";

        case EVENT_RETRANSMIT:
            return "RETRANSMIT";

        default:
            return "UNKNOWN";
    }
}


/*
 * This function is called automatically
 * whenever an event arrives from the Ring Buffer.
 */
static int handle_event(
    void *ctx,
    void *data,
    size_t data_sz
)
{
    /*
     * Interpret the raw Ring Buffer data
     * as our struct event.
     */
    const struct event *e = data;


    /*
     * Print event to terminal.
     */
    printf(
        "EVENT=%s | PID=%u | PROCESS=%s | TIME=%llu ns\n",

        event_type_to_string(e->type),

        e->pid,

        e->comm,

        e->timestamp_ns
    );


    return 0;
}


int main(void)
{
    /*
     * Pointer to generated BPF skeleton.
     */
    struct tcp_monitor_bpf *skel;


    /*
     * Pointer to user-space Ring Buffer.
     */
    struct ring_buffer *rb;


    /*
     * Variable for storing errors.
     */
    int err;


    /*
     * Handle Ctrl+C.
     */
    signal(SIGINT, handle_signal);


    /*
     * Handle termination signal.
     */
    signal(SIGTERM, handle_signal);


    /*
     * STEP 1:
     *
     * Open the eBPF object.
     */
    skel = tcp_monitor_bpf__open();

    if (!skel) {

        fprintf(
            stderr,
            "Failed to open BPF skeleton\n"
        );

        return 1;
    }


    /*
     * STEP 2:
     *
     * Load eBPF programs into the kernel.
     */
    err = tcp_monitor_bpf__load(skel);

    if (err) {

        fprintf(
            stderr,
            "Failed to load BPF program: %d\n",
            err
        );

        goto cleanup;
    }


    /*
     * STEP 3:
     *
     * Attach eBPF programs to their hooks.
     */
    err = tcp_monitor_bpf__attach(skel);

    if (err) {

        fprintf(
            stderr,
            "Failed to attach BPF program: %d\n",
            err
        );

        goto cleanup;
    }


    /*
     * STEP 4:
     *
     * Create a Ring Buffer reader.
     *
     * skel->maps.events
     * refers to the Ring Buffer created
     * inside the BPF program.
     */
    rb = ring_buffer__new(

        bpf_map__fd(
            skel->maps.events
        ),

        handle_event,

        NULL,

        NULL
    );


    if (!rb) {

        fprintf(
            stderr,
            "Failed to create Ring Buffer\n"
        );

        goto cleanup;
    }


    printf("\n");
    printf("====================================\n");
    printf(" TCP PERFORMANCE MONITOR STARTED\n");
    printf("====================================\n\n");

    printf(
        "Monitoring:\n"
        "- Connection events\n"
        "- TCP retransmissions\n\n"
    );

    printf("Press Ctrl+C to stop.\n\n");


    /*
     * STEP 5:
     *
     * Continuously wait for events.
     */
    while (!stop) {

        err = ring_buffer__poll(
            rb,
            100
        );


        /*
         * Check for serious errors.
         */
        if (err < -1) {

            fprintf(
                stderr,
                "Ring Buffer polling error: %d\n",
                err
            );

            break;
        }
    }


    /*
     * Free Ring Buffer resources.
     */
    ring_buffer__free(rb);


cleanup:

    /*
     * Detach and destroy BPF resources.
     */
    tcp_monitor_bpf__destroy(skel);


    printf("\nTCP Monitor stopped.\n");

    return err < 0 ? -err : 0;
}
